# LiteLLM Master Key (Used to log into the Admin UI & authenticate API calls)
LITELLM_MASTER_KEY=sk-litellm-change-me-secure-key

# Database Settings (Required for Admin UI, User/Key Management, Spend Tracking)
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm_secure_password_change_me
POSTGRES_DB=litellm

# Primary: Google AI Studio API Key (Free Tier)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Fallback: Google Cloud Vertex AI Settings
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Google Application Credentials (if using GCP Service Account JSON keyfile)
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-key.json
